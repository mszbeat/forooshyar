DATABASE_URL=postgresql://forooshyar:change-me@localhost:5432/forooshyar?schema=public
# Cache is optional. When true, REDIS_URL must be a valid redis:// or rediss:// URL.
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CHANNEL_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
PORT=3001

# Frontend browser origins allowed by the API, comma-separated.
CORS_ORIGINS=http://localhost:3000
# Public API base URL used by the frontend; embedded at Next.js build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
