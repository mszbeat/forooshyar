{
  "name": "forooshyar-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/config.test.ts test/cache.test.ts test/fresh.test.ts test/logging.test.ts test/discovery.test.ts test/ai.test.ts test/understand.test.ts test/telegram.test.ts test/admin.test.ts test/polish.test.ts test/delivery.test.ts test/sales.test.ts test/instagram.test.ts test/merchant-dataset.test.ts test/subscriptions.test.ts test/names.test.ts test/variant-combinations.test.ts test/card-crypto.test.ts test/shipping.test.ts test/receipt-verify.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node -r ts-node/register scripts/prisma-cli.ts migrate dev",
    "prisma:deploy": "node -r ts-node/register scripts/prisma-cli.ts migrate deploy",
    "postinstall": "prisma generate",
    "test:integration": "node --import tsx --test test/integration.test.ts",
    "start": "node dist/main.js",
    "audit:prune": "node -r ts-node/register scripts/prune-audit.ts",
    "eval": "node -r ts-node/register eval/run.ts",
    "profiles:backfill": "node -r ts-node/register scripts/backfill-profiles.ts",
    "telegram:setup": "node -r ts-node/register scripts/telegram-setup.ts",
    "instagram:setup": "node -r ts-node/register scripts/instagram-setup.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.22.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "multer": "^2.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yauzl": "^3.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.17.19",
    "@types/yauzl": "^2.10.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
