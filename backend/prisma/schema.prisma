generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: اتصال runtime از pooler تراکنشی (پورت 6543) با
  //   ?pgbouncer=true&connection_limit=5
  // DIRECT_URL: اتصال مستقیم/session برای مهاجرت‌ها (prisma migrate deploy).
  //   اگر DIRECT_URL خالی باشد، Prisma از DATABASE_URL استفاده می‌کند.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Append-only audit trail. Every mutating request writes one row; read requests
// are written to stdout only unless AUDIT_LOG_READS is enabled.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now())
  requestId    String
  action       String
  method       String
  path         String
  statusCode   Int
  success      Boolean  @default(true)
  durationMs   Int      @default(0)
  shopId       String?  @db.Uuid
  userId       String?  @db.Uuid
  entity       String?
  entityId     String?
  ip           String?
  userAgent    String?
  errorCode    String?
  errorMessage String?
  meta         Json?

  @@index([shopId, createdAt])
  @@index([shopId, action, createdAt])
  @@index([createdAt])
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  phone        String?   @unique
  phoneVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  shop         Shop?
}

model Shop {
  id             String                 @id @default(uuid()) @db.Uuid
  ownerId        String                 @unique @db.Uuid
  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  name           String
  active         Boolean                @default(true)
  tone           String                 @default("")
  shipping       String                 @default("")
  payment        String                 @default("")
  workingHours   String                 @default("")
  handoffMessage String                 @default("برای پاسخ دقیق‌تر با فروشنده هماهنگ می‌کنم.")
  /// سیاست مرجوعی/تعویض؛ اگر پر باشد بات خودش جواب می‌دهد.
  returns        String                 @default("")
  createdAt      DateTime               @default(now())
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  smsPhone       String   @default("")
  notifySellerBySms Boolean @default(true)
  /// ارسال پیامک برای این فروشگاه فعال است؟ (سطح پلتفرم: SMS_ENABLED)
  smsEnabled     Boolean  @default(true)
  /// پیامک سفارش (به مشتری و فروشنده) برای این فروشگاه فعال است؟
  /// فقط وقتی پلن آن را دارد یا افزودنی‌اش خریداری شده.
  orderSmsEnabled Boolean @default(false)
  subscriptions  Subscription[]
  products       Product[]
  variants       Variant[]
  movements      StockMovement[]
  operations     StockOperation[]
  channel        Channel?
  conversations  TelegramConversation[]
  orders         Order[]
  chatMessages   ChatMessage[]
  stockAlerts    StockAlert[]
  paymentMethods ShopPaymentMethod[]
  shippingMethods ShippingMethod[]
  channelConnections ChannelConnection[]
  inboundCommentEvents InboundCommentEvent[]
  automations Automation[]
  postLinks   ProductPostLink[]
  carts       Cart[]
  knowledgeItems KnowledgeItem[]
  assistantPrompts AssistantPrompt[]
  aiCreditLedger AiCreditLedger[]
  /// سیاست رسید پرداخت (فاز V2-3): تأیید خودکار روشن است یا نه، سقف مبلغ
  /// تأیید خودکار و مهلت انتظار پرداخت (ساعت) قبل از آزادشدن موجودی.
  receiptAutoConfirm Boolean @default(true)
  receiptAutoConfirmMax Int?
  paymentWaitHours     Int     @default(24)
}

/// روش پرداخت فروشگاه: کارت‌به‌کارت. شماره کارت فقط رمزنگاری‌شده ذخیره
/// می‌شود و در پاسخ‌ها/لاگ‌ها فقط ماسک‌شده (****1234) دیده می‌شود.
/// درگاه آنلاین فقط برای فروش پلن/اعتبار به فروشنده است، نه پرداخت مشتری.
model ShopPaymentMethod {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @db.Uuid
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// نام دارنده‌ی کارت (همان‌طور که روی کارت است).
  holderName   String
  /// شماره کارت رمزنگاری‌شده (AES-256-GCM با کلید `CARD_ENCRYPTION_KEY`).
  cardNumberEnc String
  /// هش یک‌طرفه برای تشخیص کارت تکراری (بدون ذخیره‌ی plaintext).
  cardHash     String   @default("")
  /// چهار رقم آخر برای نمایش ماسک‌شده.
  cardLast4    String
  /// نام بانک (اختیاری، مثل «ملی» یا «ملت»).
  bankName     String   @default("")
  /// شبا (اختیاری).
  sheba        String   @default("")
  /// متن دستور پرداخت که به مشتری نمایش داده می‌شود.
  instruction  String   @default("")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shopId, id])
  @@index([shopId, active])
}

/// نوع کالا: فیزیکی یا خدمت. یک فروشگاه می‌تواند هر دو را داشته باشد.
enum ProductType {
  PRODUCT
  SERVICE
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @db.Uuid
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  /// کد محصول برای ایمپورت گروهی و SKU خودکار (اختیاری).
  code        String?
  title       String
  description String    @default("")
  category    String    @default("")
  active      Boolean   @default(true)
  /// PRODUCT = کالای فیزیکی، SERVICE = خدمت (بدون موجودی/ارسال پیش‌فرض).
  type        ProductType @default(PRODUCT)
  /// کالای فیزیکی قابل ارسال است یا فقط تحویل حضوری/دیجیتال؟
  isShippable Boolean   @default(true)
  /// قیمت و موجودی پیش‌فرض محصول؛ هنگام «تولید ترکیب» در همه‌ی واریانت‌ها
  /// پیش‌پر می‌شود و فروشنده می‌تواند هر واریانت را جدا ویرایش کند.
  defaultPrice Int?
  defaultStock Int?
  /// قیمت قبل از تخفیف (برای نمایش «٪ تخفیف»)؛ اختیاری.
  compareAtPrice Int?
  /// فیلدهای خدمت: مدت انجام (دقیقه)، نیاز به نوبت/رزرو، ظرفیت هر نوبت.
  serviceDurationMinutes Int?
  serviceRequiresBooking Boolean @default(false)
  serviceCapacity        Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  variants    Variant[]
  attributes  ProductAttribute[]
  alerts      StockAlert[]
  postLinks   ProductPostLink[]

  @@unique([shopId, id])
  @@unique([shopId, code])
  @@index([shopId, title])
}

/// یک ویژگی آزاد محصول (مثل «رنگ» یا «جنس») با مقادیرش.
/// نام و مقدار متن آزادند؛ از ورودی‌های قبلی پیشنهاد داده می‌شوند.
model ProductAttribute {
  id        String                 @id @default(uuid()) @db.Uuid
  shopId    String                 @db.Uuid
  productId String                 @db.Uuid
  product   Product                @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)
  name      String
  sortOrder Int                    @default(0)
  values    ProductAttributeValue[]

  @@unique([shopId, id])
  @@unique([shopId, productId, name])
  @@index([shopId, productId])
}

model ProductAttributeValue {
  id          String           @id @default(uuid()) @db.Uuid
  shopId      String           @db.Uuid
  attributeId String           @db.Uuid
  attribute   ProductAttribute @relation(fields: [shopId, attributeId], references: [shopId, id], onDelete: Cascade)
  value       String
  sortOrder   Int              @default(0)

  @@unique([shopId, id])
  @@unique([shopId, attributeId, value])
  @@index([shopId, attributeId])
}

model Variant {
  id             String           @id @default(uuid()) @db.Uuid
  shopId         String           @db.Uuid
  productId      String           @db.Uuid
  shop           Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  product        Product          @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Restrict)
  sku            String?
  size           String           @default("")
  color          String           @default("")
  /// نگاشت گزینه‌ها از ویژگی‌های محصول، مثل {"رنگ": "مشکی", "سایز": "M"}.
  /// منبع حقیقت برای واریانت‌های تولیدشده از ترکیب است؛ size/color برای
  /// سازگاری با کدهای قدیمی (بات، سفارش) همگام نگه داشته می‌شوند.
  optionsJson    Json             @default("{}")
  /// کلید نرمال‌شده‌ی مجموعه‌ی ویژگی‌ها (combinationKey) برای یکتایی
  /// productId+attribute set در سطح دیتابیس.
  comboKey       String           @default("")
  price          Int
  stock          Int              @default(0)
  active         Boolean          @default(true)
  stockUpdatedAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  movements      StockMovement[]
  operations     StockOperation[]
  orderItems     OrderItem[]

  @@unique([shopId, id])
  @@unique([shopId, sku])
  @@unique([shopId, productId, comboKey])
  @@index([shopId, productId])
}

model StockMovement {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  variantId String   @db.Uuid
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  variant   Variant  @relation(fields: [shopId, variantId], references: [shopId, id], onDelete: Restrict)
  delta     Int
  reason    String
  actorId   String   @db.Uuid
  createdAt DateTime @default(now())

  @@index([shopId, variantId, createdAt])
}

// A successful sale and its idempotency record commit atomically.
model StockOperation {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @db.Uuid
  variantId   String   @db.Uuid
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  variant     Variant  @relation(fields: [shopId, variantId], references: [shopId, id], onDelete: Restrict)
  requestKey  String
  quantity    Int
  resultStock Int?
  createdAt   DateTime @default(now())

  @@unique([shopId, requestKey])
  @@index([shopId, variantId])
}

// ---------------------------------------------------------------------------
// تلگرام
// ---------------------------------------------------------------------------

// اتصال فروشگاه به بات مشترک. `code` همان بخشی است که در لینک
// t.me/<bot>?start=<code> به مشتری داده می‌شود؛ `ownerCode` یک‌بارمصرف است تا
// فروشنده چت خودش را وصل کند و اعلان‌ها به او برسد.
model Channel {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @unique @db.Uuid
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  code          String    @unique
  ownerCode     String?   @unique
  ownerChat     String?
  ownerLinkedAt DateTime?
  botUsername   String    @default("")
  /// پیج اینستاگرامی که دایرکت‌هایش به این فروشگاه می‌رود (UUID از BoxAPI).
  /// یکتا است: هر حساب اینستاگرام فقط یک فروشگاه دارد و پیام‌هایش نباید بین
  /// دو فروشگاه پخش شود.
  instagramAccountId String?   @unique
  /// نام کاربری پیج، از `/service/accounts` باکس‌ای‌پی.
  instagramUsername  String?
  /// عکس پروفایل پیج، فقط برای نمایش در پنل.
  instagramProfilePhoto String?
  /// تاریخ انقضای دسترسی پیج؛ بعد از آن فروشنده باید دوباره لاگین کند.
  instagramExpiresAt DateTime?
  instagramLinkedAt  DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
}

// وضعیت گفتگوی هر مشتری با هر فروشگاه. chatId شناسه‌ی چت تلگرام است.
// `draft` مرحله‌ی جاری سفارش‌گیری در بات است (ثبت سفارش چند پیام طول می‌کشد و
// webhook بی‌حالت است، پس حالت باید جایی ذخیره شود).
model TelegramConversation {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @db.Uuid
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  chatId       String
  username     String   @default("")
  firstName    String   @default("")
  /// آخرین تلاش برای تکمیل نام/نام کاربری از BoxAPI (اینستاگرام). برای کش و
  /// جلوگیری از فراخوانی تکراری به BoxAPI برای یک مشتری.
  profileEnrichedAt DateTime?
  messageCount Int      @default(0)
  draft        Json?
  /// وضعیت سؤال روشن‌کننده: { round, messages[] } — بعد از چند بار، ارجاع به انسان.
  clarify      Json?
  /// take-over: فروشنده گفتگو را «در دست گرفته» و بات دیگر خودکار جواب نمی‌دهد.
  humanTakeover Boolean  @default(false)
  /// منبع آخرین پاسخ بات (برای نشانگر AI در اینباکس): fresh | llm | handoff
  lastReplySource String @default("")
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([shopId, chatId])
  @@index([shopId, lastSeenAt])
}

// ---------------------------------------------------------------------------
// سفارش
// ---------------------------------------------------------------------------

// سفارشی که مشتری از داخل بات ثبت می‌کند. موجودی همان لحظه‌ی ساخت سفارش
// رزرو (کم) می‌شود تا دو مشتری هم‌زمان یک عدد آخر را نخرند؛ اگر پرداخت نشد یا
// سفارش لغو شد، موجودی برمی‌گردد.
enum OrderStatus {
  AWAITING_PAYMENT
  RECEIPT_RECEIVED
  NEEDS_REVIEW
  PAID
  PREPARING
  SHIPPED
  COMPLETED
  CANCELLED
  EXPIRED
}

/// حکم وریفای رسید پرداخت.
enum ReceiptVerdict {
  CONFIRMED
  NEEDS_REVIEW
  REJECTED
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  shopId          String      @db.Uuid
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  // کد کوتاه برای پیگیری توسط مشتری و فروشنده (بدون uuid در پیام)
  code            String      @unique
  status          OrderStatus @default(AWAITING_PAYMENT)
  // مشتری
  chatId          String?
  customerName    String      @default("")
  customerPhone   String      @default("")
  // نشانی ساختیافته: انتخاب استان/شهر از لیست و بقیه دستی. `address` نسخه‌ی
  // یک‌خطی و آماده‌ی چاپ/کپی است تا خروجی‌ها و اکسپورت‌های قدیمی نشکنند.
  address         String      @default("")
  province        String      @default("")
  city            String      @default("")
  street          String      @default("")
  alley           String      @default("")
  plaque          String      @default("")
  unit            String      @default("")
  postalCode      String      @default("")
  note            String      @default("")
  /// جمع اقلام (بدون ارسال/تخفیف).
  subtotal        Int         @default(0)
  /// هزینه ارسال محاسبه‌شده سمت سرور؛ جزئی از جمع کل است.
  shippingCost    Int         @default(0)
  shippingMethodId String?    @db.Uuid
  shippingMethod  ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  /// تخفیف (تومان)؛ فعلاً فقط دستی از پنل.
  discount        Int         @default(0)
  total           Int
  // پرداخت (کارت‌به‌کارت؛ درگاه آنلاین فقط برای پلن/اعتبار پلتفرم است)
  paymentProvider String      @default("card_to_card")
  paymentAuthority String?
  paymentRefId    String      @default("")
  paidAt          DateTime?
  cancelledReason String      @default("")
  items           OrderItem[]
  receipts        PaymentReceipt[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([shopId, paymentAuthority])
  @@unique([shopId, id])
  @@index([shopId, createdAt])
  @@index([shopId, status])
}

/// روش ارسال فروشگاه با قانون هزینه:
///  - FIXED: مبلغ ثابت
///  - FREE_OVER: رایگان بالای آستانه، وگرنه مبلغ ثابت
///  - TABLE: جدول استانی/شهری (در `rulesJson`)
///  - PICKUP: برداشت حضوری (رایگان)
model ShippingMethod {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @db.Uuid
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  kind        String   @default("FIXED")
  /// مبلغ پایه (تومان) برای FIXED/FREE_OVER.
  baseCost    Int      @default(0)
  /// آستانه‌ی رایگان‌شدن برای FREE_OVER.
  freeOver    Int?
  /// جدول هزینه برای TABLE: { "تهران": 45000, "تهران/شهریار": 60000, "*": 80000 }
  rulesJson   Json     @default("{}")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@unique([shopId, id])
  @@index([shopId, active])
}

/// رسید پرداخت کارت‌به‌کارت که مشتری فرستاده است.
/// تصویر در ذخیره‌ی خصوصی نگه داشته می‌شود؛ JSON استخراج‌شده و نتیجه‌ی
/// چک‌های قطعی هم ذخیره می‌شود تا بررسی فروشنده و audit کامل باشد.
model PaymentReceipt {
  id            String         @id @default(uuid()) @db.Uuid
  shopId        String         @db.Uuid
  orderId       String         @db.Uuid
  order         Order          @relation(fields: [shopId, orderId], references: [shopId, id], onDelete: Cascade)
  /// مسیر/کلید تصویر در ذخیره‌ی خصوصی.
  imageRef      String
  /// هش SHA-256 تصویر برای تشخیص رسید تکراری.
  imageHash     String
  /// JSON استخراج‌شده از رسید (مبلغ، مقصد، زمان، شماره پیگیری…).
  extractedJson Json           @default("{}")
  /// نتیجه‌ی چک‌های قطعی: [{ check, ok, detail }]
  checksJson    Json           @default("[]")
  verdict       ReceiptVerdict @default(NEEDS_REVIEW)
  /// دلیل حکم (برای نمایش به فروشنده/مشتری).
  verdictReason String         @default("")
  /// بررسی دستی فروشنده.
  reviewedBy    String?        @db.Uuid
  reviewedAt    DateTime?
  reviewNote    String         @default("")
  createdAt     DateTime       @default(now())

  @@unique([shopId, id])
  @@unique([shopId, imageHash])
  @@index([shopId, orderId])
  @@index([shopId, verdict])
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopId    String   @db.Uuid
  variantId String?  @db.Uuid
  variant   Variant? @relation(fields: [shopId, variantId], references: [shopId, id], onDelete: Restrict)
  // عنوان و مشخصات در لحظه‌ی ثبت کپی می‌شوند؛ تغییر نام محصول نباید سفارش قدیمی را عوض کند.
  title     String
  spec      String   @default("")
  price     Int
  quantity  Int

  @@index([orderId])
  @@index([shopId, variantId])
}

// پیام‌های ردوبدل‌شده بین فروشنده و مشتری در تلگرام.
// چرا ذخیره می‌شود: فروشنده از پنل یا از خود بات جواب می‌دهد و باید ببیند چه
// چیزی قبلاً گفته شده؛ بدون این جدول هر پاسخ یک تیر در تاریکی است.
model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  chatId    String
  // 'in' = پیام مشتری، 'out' = پیام سمت فروشگاه (بات یا فروشنده)
  direction String
  /// نویسنده: 'customer' | 'bot' | 'seller'.
  /// چرا جدا از direction: پنل باید پاسخ خودکار بات را از پاسخ دستی فروشنده
  /// تفکیک کند (برچسب «فروشنده» فقط روی دومی می‌آید).
  author    String   @default("customer")
  text      String
  orderId   String?  @db.Uuid
  // پاسخ به یک پیام مشخص (مثل «ریپلای» تلگرام). متن نقل‌شده کپی می‌شود تا اگر
  // پیام اصلی پاک شد، نقل‌قول در تاریخچه همچنان خوانا بماند.
  replyToId String?  @db.Uuid
  replyText String   @default("")
  /// 'in' = پیام مشتری، 'out' = پیام فروشنده — همان کسی که پیام اصلی از او بود.
  replyFrom String   @default("")
  createdAt DateTime @default(now())

  @@index([shopId, chatId, createdAt])
  @@index([shopId, createdAt])
  /// برای فیلتر «پاسخ‌های بات/فروشنده» در پنل؛ در migration چت‌اauthor ساخته شد
  /// ولی در schema جا افتاده بود (drift) و همین‌جا کامل شد.
  @@index([shopId, author])
}

// «اگر موجود شد خبرم کن».
// چرا جدول جدا: این یک درخواست آینده‌ی مشتری است، نه وضعیت گفتگو؛ باید با
// افزایش موجودی trigger شود و تا ابد در گفتگو نماند. بعد از اطلاع‌دادن، `notifiedAt`
// پر می‌شود تا دوباره پیام نرود (مگر مشتری دوباره درخواست کند).
model StockAlert {
  id         String    @id @default(uuid()) @db.Uuid
  shopId     String    @db.Uuid
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId  String    @db.Uuid
  product    Product   @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)
  chatId     String
  firstName  String    @default("")
  /// اگر مشتری سایز/رنگ مشخصی خواسته بود، همان ذخیره می‌شود.
  variantId  String?   @db.Uuid
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([shopId, chatId, productId])
  @@index([shopId, productId, notifiedAt])
}

// هر رویداد webhook اینستاگرام (BoxAPI) فقط یک‌بار پردازش می‌شود.
// BoxAPI اگر ۲۰۰ نگیرد تا ۳ بار در ۶۰ ثانیه دوباره می‌فرستد؛ بدون این جدول
// مشتری جواب تکراری می‌گرفت و سفارش دوبار ثبت می‌شد.
model InstagramEvent {
  eventId    String   @id
  eventType  String   @default("")
  receivedAt DateTime @default(now())
  /// بدنه‌ی خام رویداد (بریده‌شده). برای عیب‌یابی «چرا دایرکت نیامد» لازم است:
  /// BoxAPI شکل‌های متفاوتی می‌فرستد و بدون دیدن بدنه نمی‌شود فهمید کدام کلید
  /// پیام را دارد. هیچ توکنی در بدنه نیست.
  payload    String?

  @@index([receivedAt])
}

// تلگرام اگر ۲۰۰ نگیرد همان update را دوباره می‌فرستد. این جدول تضمین می‌کند
// هر update_id فقط یک‌بار پردازش شود (بدون پاسخ تکراری به مشتری).
model TelegramUpdate {
  updateId   BigInt   @id
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// ادمین پلتفرم
// ---------------------------------------------------------------------------

/// حساب ادمین سامانه — کاملاً جدا از حساب فروشنده (`User`).
/// ادمین فروشگاه ندارد؛ به همین دلیل AuthGuard فروشنده هرگز توکن او را قبول
/// نمی‌کند و برعکس. رمز با scrypt ذخیره می‌شود، هرگز به‌صورت متن.
model SubscriptionPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  /// شناسه‌ی پایدار برای URL صفحه‌ی جزئیات (`/plans/[slug]`).
  slug                String   @unique
  name                String
  tagline             String   @default("")
  description         String   @default("")
  /// فهرست امکانات برای نمایش در کارت‌ها (آرایه‌ی رشته).
  features            Json     @default("[]")
  monthlyPrice        Int      @default(0)
  /// قیمت قبل از تخفیف (برای نمایش خط‌خورده)؛ صفر یعنی بدون تخفیف.
  listMonthlyPrice    Int      @default(0)
  instagramLimit      Int
  telegramLimit       Int
  /// سقف پیام ماهانه‌ی هوش مصنوعی؛ صفر یعنی نامحدود.
  monthlyMessageLimit Int      @default(0)
  /// سقف پاسخ هوش مصنوعی در روز؛ صفر یعنی بدون سقف روزانه.
  dailyMessageLimit   Int      @default(0)
  /// سقف تعداد محصول؛ صفر یعنی نامحدود.
  productLimit        Int      @default(0)
  /// سقف تعداد اتوماسیون؛ صفر یعنی نامحدود.
  automationLimit     Int      @default(0)
  /// سقف پیامک ماهانه؛ صفر یعنی نامحدود.
  smsLimit            Int      @default(0)
  /// پیامک سفارش در این پلن گنجانده شده؟ (opt-in پیش‌فرض)
  orderSmsIncluded     Boolean  @default(false)
  /// هزینه‌ی ماهانه‌ی افزودنی پیامک سفارش (تومان)؛ صفر یعنی غیرقابل خرید.
  orderSmsMonthlyPrice Int      @default(0)
  isPopular           Boolean  @default(false)
  active              Boolean  @default(false)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  subscriptions       Subscription[]

  @@index([active, sortOrder])
}

model Subscription {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @db.Uuid
  planId         String   @db.Uuid
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  plan           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  status         String   @default("PENDING")
  months         Int
  amount         Int
  /// تعداد پیج اینستاگرام اضافه‌ی خریداری‌شده (افزودنیِ هر پیج هزینه دارد).
  extraInstagram Int      @default(0)
  /// افزودنی پیامک سفارش در این خرید فعال شده؟ (هزینه‌ی اضافه پرداخت شده)
  orderSms      Boolean  @default(false)
  discountCode   String   @default("")
  authority      String?  @unique
  referenceId    String   @default("")
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([shopId, status, endsAt])
}

/// کد تخفیف اشتراک؛ درصد تخفیف روی جمع کل اعمال می‌شود.
model DiscountCode {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  percent   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PlatformAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String    @default("")
  /// اگر true باشد، ادمین باید در اولین ورود رمز را عوض کند (حساب seedشده).
  mustChangePassword Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}

/// تنظیمات سطح پلتفرم که از پنل ادمین ویرایش می‌شوند.
///
/// `secret` یعنی مقدار رمزآلود است و در خواندن ماسک می‌شود؛ مقدار خام فقط
/// یک‌بار (هنگام ذخیره) در پاسخ برنمی‌گردد.
model OtpChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  userId    String?  @db.Uuid
  purpose   String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model AppSetting {
  key       String   @id
  value     String   @default("")
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid
}

/// پلتفرم کانال پیام‌رسانی.
enum ChannelPlatform {
  INSTAGRAM
  TELEGRAM
  BALE
  RUBIKA
}

/// وضعیت اتصال کانال.
enum ChannelConnectionStatus {
  CONNECTED
  EXPIRED
  DISCONNECTED
  ERROR
}

/// اتصال یک فروشگاه به یک حساب در یک پلتفرم.
/// این مدل کنار مدل قدیمی `Channel` می‌نشیند تا اتصال‌های موجود نشکنند؛
/// اتصال‌های تازه از همین‌جا مدیریت می‌شوند.
model ChannelConnection {
  id          String                @id @default(uuid()) @db.Uuid
  shopId      String                @db.Uuid
  shop        Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  platform    ChannelPlatform
  status      ChannelConnectionStatus @default(CONNECTED)
  /// نام نمایشی حساب (نام پیج/بات).
  displayName String                @default("")
  /// نام کاربری حساب.
  username    String                @default("")
  /// عکس پروفایل حساب.
  avatarUrl   String                @default("")
  /// شناسه‌ی حساب در پلتفرم (account_id اینستاگرام، chat_id بات و…).
  externalId  String                @default("")
  /// توکن/سکرت رمزنگاری‌شده (تلگرام/بله/روبیکا)؛ برای اینستاگرام خالی است
  /// چون احراز هویت با کلید سراسری BoxAPI انجام می‌شود.
  secretEnc   String                @default("")
  expiresAt   DateTime?
  lastSeenAt  DateTime?
  lastError   String                @default("")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([shopId, platform, externalId])
  @@index([shopId, platform])
  @@index([platform, externalId])
}

/// رویداد خام کامنت اینستاگرام — قبل از هر پارسی، همان‌طور که از webhook
/// آمده ذخیره می‌شود تا هیچ فیلدی حدس زده نشود و برای عیب‌یابی بماند.
model InboundCommentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @db.Uuid
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// شناسه‌ی کامنت در اینستاگرام (برای idempotency).
  commentId   String
  /// شناسه‌ی پست/مدیا.
  mediaId     String   @default("")
  /// شناسه‌ی نویسنده‌ی کامنت.
  senderId    String   @default("")
  text        String   @default("")
  /// بدنه‌ی خام رویداد.
  rawJson     Json     @default("{}")
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([shopId, commentId])
  @@index([shopId, createdAt])
}

/// موجودیت اتوماسیون کامنت→دایرکت.
model Automation {
  id              String   @id @default(uuid()) @db.Uuid
  shopId          String   @db.Uuid
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name            String   @default("اتوماسیون کامنت به دایرکت")
  active          Boolean  @default(true)
  /// دامنه: ALL = همه‌ی پست‌ها، SELECTED = فقط پست‌های انتخاب‌شده.
  scope           String   @default("ALL")
  /// شناسه‌های پست برای scope=SELECTED.
  mediaIdsJson    Json     @default("[]")
  /// کلمات/عبارت‌های تریگر (نرمال‌سازی فارسی در کد).
  triggerWordsJson Json    @default("[]")
  /// پاسخ عمومی کامنت (تا ۳ گونه؛ یکی تصادفی انتخاب می‌شود).
  publicRepliesJson Json  @default("[]")
  /// قالب پیام DM با متغیرها: {product_title} {price} {stock} {shop_name}
  dmTemplate      String   @default("")
  /// محصول لینک‌شده به پست (تسک ۸): اگر ست باشد، DM همان محصول را می‌فرستد.
  productId       String?  @db.Uuid
  /// گیت «اول فالو کن» روشن است یا نه.
  requireFollow   Boolean  @default(false)
  /// سقف پاسخ در روز برای هر پیج.
  dailyCap        Int      @default(200)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  runs            AutomationRun[]

  @@unique([shopId, id])
  @@index([shopId, active])
}

/// لاگ اجرای اتوماسیون برای هر کامنت.
model AutomationRun {
  id           String     @id @default(uuid()) @db.Uuid
  shopId       String     @db.Uuid
  automationId String     @db.Uuid
  automation   Automation @relation(fields: [shopId, automationId], references: [shopId, id], onDelete: Cascade)
  commentId    String
  /// وضعیت: SKIPPED / PUBLIC_REPLIED / DM_SENT / FOLLOW_WAIT / FAILED / DEAD_LETTER
  status       String
  detail       String     @default("")
  createdAt    DateTime   @default(now())

  @@index([shopId, automationId, createdAt])
  @@index([shopId, commentId])
}

/// دانش فروشگاه: پرسش‌وپاسخ‌هایی که دستیار از روی آن‌ها جواب می‌دهد.
/// محصولات/خدمات از کاتالوگ می‌آیند؛ این جدول برای سؤال‌های پرتکرار است.
model KnowledgeItem {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  /// کلمات کلیدی برای تطبیق (با کاما جدا).
  keywords  String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, id])
  @@index([shopId, active])
}

/// پرامپت‌های دستیار (سه زبانه) با نسخه‌ها.
/// لایه‌ی ایمنی (A0) قفل است و در کد زندگی می‌کند؛ این‌جا فقط نقش/لحن/روند.
model AssistantPrompt {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// role | tone | flow
  tab       String
  content   String
  version   Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([shopId, id])
  @@index([shopId, tab, version])
}

/// بسته‌ی اعتبار پاسخ AI که فروشنده می‌خرد (درگاه پلتفرم).
/// قیمت‌ها placeholder و قابل ویرایش از پنل ادمین‌اند.
model CreditPack {
  id          String   @id @default(uuid()) @db.Uuid
  /// شناسه‌ی پایدار برای URL.
  slug        String   @unique
  name        String
  /// تعداد پاسخ AI در بسته.
  credits     Int
  price       Int
  /// قیمت قبل از تخفیف؛ صفر یعنی بدون تخفیف.
  listPrice   Int      @default(0)
  active      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// دفتر اعتبار پاسخ AI هر فروشگاه.
/// هر پاسخ AI یک ردیف منفی می‌نویسد؛ خرید بسته یک ردیف مثبت.
/// مانده = مجموع delta. این جدول هم حسابداری است هم گزارش مصرف.
model AiCreditLedger {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// مثبت = خرید/هدیه، منفی = مصرف پاسخ AI.
  delta     Int
  reason    String
  /// شناسه‌ی مرجع (سفارش خرید، گفتگو…).
  refId     String   @default("")
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
}

/// لینک محصول به پست اینستاگرام (تسک ۸): mediaId↔productId برای هر فروشگاه یکتا.
/// کامنت روی پستِ لینک‌شده، محصول همان پست را در DM می‌فرستد.
model ProductPostLink {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @db.Uuid
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)
  /// شناسه‌ی عددی مدیا از وب‌هوک (برای تطبیق کامنت).
  mediaId   String
  /// شورت‌کد پست (برای نمایش/لینک).
  shortcode String   @default("")
  createdAt DateTime @default(now())

  @@unique([shopId, mediaId])
  @@index([shopId, productId])
}

/// سبد خرید سمت سرور برای هر گفتگو (تسک ۱۲): چندقلمی، با انقضا.
/// itemsJson: [{ variantId, quantity }]
model Cart {
  id             String   @id @default(uuid()) @db.Uuid
  shopId         String   @db.Uuid
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  conversationId String
  itemsJson      Json     @default("[]")
  expiresAt      DateTime
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([shopId, conversationId])
  @@index([shopId, expiresAt])
}
