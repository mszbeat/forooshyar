# --- دیتابیس -------------------------------------------------------------------
# دو راه: یا DB_* (پیشنهاد برای نصب دستی) یا DATABASE_URL (پیشنهاد برای PaaS).
#
# روی Supabase/pooler:
#   DATABASE_URL = اتصال runtime از pooler تراکنشی (پورت 6543) با
#     ?pgbouncer=true&connection_limit=5
#     (سقف را بر اساس تعداد نمونه‌های سرویس تنظیم کنید؛ هر نمونه حداکثر
#      همین تعداد اتصال باز می‌کند. pooler تراکنشی سقف بالایی دارد و برای
#      runtime درست است.)
#   DIRECT_URL = اتصال مستقیم/session (پورت 5432) فقط برای مهاجرت‌ها
#     (prisma migrate deploy). روی pooler تراکنشی مهاجرت کار نمی‌کند.
#   اگر DIRECT_URL خالی باشد، مهاجرت از DATABASE_URL استفاده می‌کند.
#
# روی Render Postgres (بدون pooler): هر دو را از connectionString دیتابیس
# پر کنید و connection_limit را دست نزنید.
DATABASE_URL=
DIRECT_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=forooshyar
DB_PASSWORD=change-me
DB_NAME=forooshyar
# disable (local only), require, or verify-full (recommended for production)
DB_SSL_MODE=disable
# روی Supabase برای جلوگیری از EMAXCONNSESSION (سقف pooler session-mode):
#   DB_PORT=6543
#   DB_PGBOUNCER=true
#   DB_CONNECTION_LIMIT=5
# این سه را با هم بگذارید تا اتصال runtime از pooler تراکنشی برود.
DB_PGBOUNCER=false
DB_CONNECTION_LIMIT=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3001
CORS_ORIGINS=http://localhost:3000
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
# کلیدهای رمزنگاری (base64 از ۳۲ بایت؛ تولید با: openssl rand -base64 32)
# در production اجباری‌اند و مقدار placeholder قبول نمی‌شود (استارتاپ fail می‌کند).
CARD_ENCRYPTION_KEY=
CHANNEL_TOKEN_ENCRYPTION_KEY=
# --- مدل زبانی (docs/AI.md) ---------------------------------------------------
# خاموش بگذاری، بات فقط با موتور قاعده‌محور (کاتالوگ + تنظیمات) جواب می‌دهد.
# روشن کنی، وقتی قاعده‌ها پیام را نفهمند یک‌بار از مدل کمک می‌گیرد.
# هر درگاهی که API سازگار با OpenAI داشته باشد کار می‌کند.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# نمونه‌ها: https://api.openai.com/v1 | https://openrouter.ai/api/v1 | http://127.0.0.1:8000/v1
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=12000
AI_MAX_OUTPUT_TOKENS=400
# سقف روزانه‌ی فراخوانی مدل برای بازنویسی لحن، به‌ازای هر فروشگاه (کنترل هزینه).
AI_POLISH_DAILY_CAP=1000
# Audit trail ------------------------------------------------------------------
# Reads (GET) are written to stdout always but stored in the AuditLog table
# only when this is true. Mutations and failures are always stored.
AUDIT_LOG_READS=false
# Used by `npm run audit:prune` (cron) to drop old rows.
AUDIT_RETENTION_DAYS=90

# --- پیامک sms.ir و OTP ---------------------------------------------------------
# کلید API از پنل sms.ir. بدون کلید، پیامک‌ها فقط در لاگ سرور ثبت می‌شوند (Mock).
SMS_API_KEY=
# خط فرستنده‌ی اختصاصی برای پیامک‌های متنی عادی (bulk).
SMS_SENDER_NUMBER=
# شناسه‌ی قالب تأییدشده‌ی sms.ir برای کد یک‌بارمصرف (POST /v1/send/verify).
# اختیاری: اگر خالی باشد، کد تأیید به‌صورت پیامک متنی عادی با خط فرستنده
# (SMS_SENDER_NUMBER) ارسال می‌شود و نیازی به ساخت قالب در پنل sms.ir نیست.
SMS_OTP_TEMPLATE_ID=
# نام پارامتر کد در قالب (پیش‌فرض Code).
SMS_OTP_PARAM_NAME=Code
# آدرس پایه‌ی API (پیش‌فرض همین است).
SMS_API_BASE=https://api.sms.ir
# ورود/ثبت‌نام با کد یک‌بارمصرف فعال باشد؟
OTP_ENABLED=false
OTP_TTL_SECONDS=300
# قیمت ماهانه‌ی افزودنی پیامک سفارش (تومان)؛ روی پلن هم قابل تنظیم است.
ORDER_SMS_ADDON_PRICE=49000

# --- تلگرام (docs/TELEGRAM.md) -----------------------------------------------
# توکن BotFather. خالی بگذار تا اتصال تلگرام غیرفعال بماند.
TELEGRAM_BOT_TOKEN=
# سکرت webhook: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- بله و روبیکا (بات مشترک) -------------------------------------------------
# یک بات مشترک برای همه‌ی فروشگاه‌ها؛ فروشنده‌ها توکن خودشان را وارد
# نمی‌کنند. این مقادیر را می‌توان از پنل ادمین هم ست کرد (اولویت با پنل).
# توکن بات بله از @BotFather:
BALE_BOT_TOKEN=
# سکرت webhook بله: openssl rand -hex 32 (بخش آخر مسیر /bale/webhook/<secret>)
BALE_WEBHOOK_SECRET=
# توکن بات روبیکا از بخش بات‌های روبیکا:
RUBIKA_BOT_TOKEN=
# سکرت webhook روبیکا: openssl rand -hex 32 (بخش آخر مسیر /rubika/webhook/<secret>)
RUBIKA_WEBHOOK_SECRET=
# نام کاربری بات‌ها برای لینک فروشگاه مشتریان (ble.ir/<username>?start=<code>)
BALE_BOT_USERNAME=
RUBIKA_BOT_USERNAME=
# آدرس عمومی API برای ثبت webhook (فقط اسکریپت setup از آن استفاده می‌کند)
PUBLIC_API_URL=
FRONTEND_URL=
# فقط برای تست با سرور جعلی
# TELEGRAM_API_BASE=http://127.0.0.1:4599

# --- اینستاگرام / دایرکت (docs/INSTAGRAM.md) -----------------------------------
# ارائه‌دهنده: boxapi (پیش‌فرض، اشتراک ماهانه) یا meta (API رسمی متا، رایگان).
# هر دو یک قرارداد را پیاده می‌کنند؛ جابه‌جایی فقط با همین مقدار است.
# اگر meta درخواست شود ولی META_APP_ID/META_APP_SECRET ست نباشد، سرویس
# خودکار به boxapi برمی‌گردد تا پروژه همیشه بالا بیاید و به خطا نخورد.
INSTAGRAM_PROVIDER=boxapi
# باکس‌ای‌پی (boxapi.ir). این چهار مقدار «پلتفرمی» هستند: یک حساب باکس‌ای‌پی
# برای کل سرویس. **پیج اینستاگرام را اینجا نگذارید** — هر فروشگاه پیج خودش را
# از پنل وصل می‌کند و شناسه‌اش روی همان فروشگاه ذخیره می‌شود.
# آدرس پایه‌ی API (پیش‌فرض همین است؛ فقط اگر BoxAPI عوض شد تغییر دهید)
INSTAGRAM_BASE_URL=https://api.sendbox.chat/api/v1
# توکن دسترسی؛ در هدر X-Api-Key فرستاده می‌شود. فقط سمت سرور می‌ماند.
INSTAGRAM_API_KEY=
# سکرت webhook؛ بدون آن امضا بررسی نمی‌شود (توصیه: حتماً ست کنید)
INSTAGRAM_WEBHOOK_SECRET=
# لینک ورود اختصاصی حساب شما در BoxAPI (instagram_oauth_url).
# همه‌ی فروشگاه‌ها همین لینک را باز می‌کنند و هر کدام با پیج خودش وارد می‌شود؛
# بعد از آن پیج در `/service/accounts` ظاهر می‌شود و فروشنده انتخابش می‌کند.
INSTAGRAM_LOGIN_URL=
# سقف زمان انتظار برای هر درخواست BoxAPI
INSTAGRAM_TIMEOUT_MS=10000
# --- Meta (API رسمی اینستاگرام، وقتی INSTAGRAM_PROVIDER=meta) ----------------
# اپ متا را در developers.facebook.com بسازید و Instagram Login را فعال کنید.
# دسترسی‌های لازم: instagram_basic، instagram_business_manage_messages،
# instagram_business_manage_comments. برای کار با اکانت فروشنده‌ها، App Review
# و Business Verification لازم است (از داخل ایران ممکن است رد شود).
META_APP_ID=
META_APP_SECRET=
# توکن تأیید handshake وب‌هوک (مقدار دلخواه؛ در داشبورد متا هم ثبت می‌شود).
META_VERIFY_TOKEN=
# نسخه‌ی Graph API (پیش‌فرض v21.0).
META_GRAPH_VERSION=v21.0
# آدرس callback برای OAuth؛ پیش‌فرض از PUBLIC_API_URL ساخته می‌شود
# ({PUBLIC_API_URL}/instagram/meta/callback) و باید در تنظیمات اپ متا
# (Valid OAuth Redirect URIs) هم ثبت شود.
META_REDIRECT_URI=

# --- پرداخت -------------------------------------------------------------------
# درگاه آنلاین فقط برای فروش پلن/اعتبار به فروشنده است (ماژول subscriptions).
# پرداخت مشتری نهایی همیشه کارت‌به‌کارت است و در پنل فروشگاه مدیریت می‌شود؛
# هیچ درگاه/لینک پرداختی در سطح فروشگاه وجود ندارد.
# مرچنت‌آیدی زرین‌پال پلتفرم. خالی بگذار تا خرید پلن در «حالت آزمایشی» باشد.
ZARINPAL_MERCHANT_ID=
# فقط برای تست با سرور جعلی زرین‌پال
# ZARINPAL_API_BASE=http://127.0.0.1:4599
# کلید رمزنگاری شماره کارت‌های فروشگاه (base64 از ۳۲ بایت). در production حتماً ست شود.
# تولید: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CARD_ENCRYPTION_KEY=

# --- پنل ادمین (docs/ADMIN.md) ------------------------------------------------
# حساب ادمین پلتفرم در اولین بالا آمدن ساخته می‌شود. رمز فقط هش ذخیره می‌شود.
# اگر بعداً رمز را گم کردید، این دو را عوض کنید و ایمیل *تازه* بگذارید؛
# ایمیل موجود بازنویسی نمی‌شود (برای تغییر رمز از صفحه‌ی «حساب ادمین» استفاده کنید).
# مقدارها را خودتان بگذارید: ایمیل ادمین و یک رمز قوی (حداقل ۱۲ کاراکتر).
# حساب ادمین در هر استارتاپ از روی این دو متغیر ساخته/به‌روزرسانی می‌شود
# (idempotent). ایمیل نرمال می‌شود (trim + lowercase). رمز حداقل ۱۲ کاراکتر.
# حساب ساخته‌شده mustChangePassword=true می‌گیرد و در اولین ورود باید رمز را عوض کند.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# --- مدل زبانی (docs/AI.md) ---------------------------------------------------
# هر درگاهی که POST {آدرس}/chat/completions را استاندارد OpenAI جواب دهد.
# هر دو مقدار را می‌توان از پنل ادمین هم ست کرد؛ پنل بر این‌ها اولویت دارد.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TEMPERATURE=0.3
