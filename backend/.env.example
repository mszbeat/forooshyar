DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=forooshyar
DB_PASSWORD=change-me
DB_NAME=forooshyar
# disable (local only), require, or verify-full (recommended for production)
DB_SSL_MODE=disable
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3001
CORS_ORIGINS=http://localhost:3000
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
CHANNEL_TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
# Audit trail ------------------------------------------------------------------
# Reads (GET) are written to stdout always but stored in the AuditLog table
# only when this is true. Mutations and failures are always stored.
AUDIT_LOG_READS=false
# Used by `npm run audit:prune` (cron) to drop old rows.
AUDIT_RETENTION_DAYS=90
