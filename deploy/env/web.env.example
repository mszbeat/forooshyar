# /etc/forooshyar/web.env   →  chmod 600, chown forooshyar
# این فایل در زمان *اجرا* خوانده می‌شود (Next build لازم نیست دوباره شود).

NODE_ENV=production
# آدرس داخلی API که app/api/[...path]/route.ts به آن پروکسی می‌کند.
API_PROXY_TARGET=http://127.0.0.1:3001
# خالی بگذار تا از پروکسی هم‌مبدأ (/api) استفاده شود.
NEXT_PUBLIC_API_BASE_URL=
# اگر build روی سروری با RAM کم شکست خورد:
# NODE_OPTIONS=--max-old-space-size=1024
