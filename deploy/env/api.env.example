# /etc/forooshyar/api.env   →  chmod 600, chown forooshyar
# سرویس‌ها با EnvironmentFile این را می‌خوانند؛ هرگز در گیت نگذار.

NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# --- دیتابیس (مدیریت‌شده: Neon / Supabase / RDS) -------------------------------
# هاست و پورت را از connection string سرویس بردار. `localhost` ننویس.
DB_HOST=ep-xxxx.region.aws.neon.tech
DB_PORT=5432
DB_USERNAME=forooshyar
DB_PASSWORD=رمز-واقعی-را-بگذار
DB_NAME=forooshyar
# verify-full: هم رمزنگاری، هم بررسی گواهی (CAهای عمومی درون سیستم‌عامل کافی‌اند).
# فقط اگر CA خصوصی داری به require بسنده کن. disable فقط برای دیتابیس لوکال.
DB_SSL_MODE=verify-full

# اختیاری: اگر کل connection string را داری، همان را بگذار؛ بر DB_* اولویت دارد.
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=verify-full

# --- امنیت --------------------------------------------------------------------
# 32 بایت تصادفی: openssl rand -base64 48
JWT_SECRET=تولید-کن-با-openssl-rand
# پنل و API یک دامنه دارند (پروکسی /api)، پس نیازی به CORS نیست.
# فقط اگر فرانت روی دامنه‌ی دیگری است، مبدأ دقیق را بگذار: https://panel.example.com
CORS_ORIGINS=

# --- لاگ / ردّ فعالیت ----------------------------------------------------------
# خواندن‌ها (GET موفق) فقط در stdout؛ با true در جدول هم ذخیره می‌شوند.
AUDIT_LOG_READS=false
AUDIT_RETENTION_DAYS=90

# --- اختیاری ------------------------------------------------------------------
CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
